# contratalux.com — Apache / LiteSpeed
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Bloquear archivos internos
RewriteRule (^|/)\.(git|github|env)(/|$) - [F,L]
RewriteRule ^(README\.md|package(-lock)?\.json|src/|scripts/|node_modules/) - [F,L]

# 2. HTTPS y dominio sin www en un solo salto 301 (contempla proxy con X-Forwarded-Proto)
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://contratalux.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://contratalux.com%{REQUEST_URI} [R=301,L,NE]

# 3. URLs canónicas: sin .html, sin /index y sin barra final
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ https://contratalux.com/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ https://contratalux.com/%1 [R=301,L,NE]
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ https://contratalux.com/%1 [R=301,L,NE]

# 4. Servir /ruta desde ruta.html, sin redirección
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Compresión (brotli si está disponible, si no gzip)
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché: HTML siempre revalidado; CSS, JS y fuentes versionados con caché larga
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(css|js|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(webp|png|jpg|mp4)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
